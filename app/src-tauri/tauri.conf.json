{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TP System Care",
  "version": "0.1.0",
  "identifier": "com.tpsystemcare.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TP System Care",
        "width": 980,
        "height": 560,
        "minWidth": 900,
        "minHeight": 540,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5MTVFN0FBRjhGRUE0Q0YKUldUUHBQNzRxdWNWZWRLbnl0SWE5cWdwVWpTR3hyMVNwNnRGZll6SU5YeEhBeEpMWk9hWW4xNUMK",
      "endpoints": [
        "https://github.com/tamphamdesigner92-tb/tp-system-care/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
